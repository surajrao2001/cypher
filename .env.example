NODE_ENV=development
APP_ENV=local

# NestJS
API_PORT=3001
API_PREFIX=v1
WEB_ORIGIN=http://localhost:3000
MOBILE_ORIGIN=http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Database (local Docker Postgres with PostGIS)
DATABASE_URL=postgresql://cypher:cypher@localhost:5433/cypher?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true

# Supabase (Auth + Storage). Do not put SERVICE_ROLE in web/mobile apps.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret. New projects sign access tokens with ES256; Nest verifies those via JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# MSG91 is used by the Send SMS Edge Function, not by Nest.
# Set these with: npx supabase secrets set KEY=value
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=
# MSG91_OTP_VAR=otp
# SEND_SMS_HOOK_SECRET=

# Razorpay (server only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=Cypher <noreply@localhost>

# Observability
SENTRY_DSN=
LOG_LEVEL=info
