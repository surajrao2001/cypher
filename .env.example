NODE_ENV=development
APP_ENV=local

# NestJS
API_PORT=3001
API_PREFIX=v1
WEB_ORIGIN=http://localhost:3000
MOBILE_ORIGIN=http://localhost:8081
# Use 127.0.0.1 on Windows so Next.js server fetches don't hang on localhost IPv6.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
# Web origin for mobile Cashfree handoff (use your LAN IP or tunnel when testing on a device)
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Cashfree.js mode for web checkout (sandbox | production)
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Database (local Docker Postgres with PostGIS)
DATABASE_URL=postgresql://cypher:cypher@localhost:5433/cypher?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true

# Supabase (Auth + Storage). Do not put SERVICE_ROLE in web/mobile apps.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Legacy HS256 JWT secret. New projects sign access tokens with ES256; Nest verifies those via JWKS at SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# First-release client OAuth (Continue with Google / Apple). Same project as server SUPABASE_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

PUBLIC_API_URL=http://127.0.0.1:3001

# LATER — Phone OTP / WhatsApp Auth Hook (parked on feat/whatsapp-otp; not first release)
# Set with: npx supabase secrets set KEY=value
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_AUTH_TEMPLATE_NAME=
# SEND_SMS_HOOK_SECRET=
# FUTURE ONLY — MSG91 SMS fallback
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER=
# MSG91_OTP_VAR=otp

# Cashfree Payment Gateway + Easy Split (server only)
# Sandbox: https://sandbox.cashfree.com/pg  · Production: https://api.cashfree.com/pg
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional. Cashfree signs webhooks with CASHFREE_SECRET_KEY by default.
# Only set this if Cashfree gave you a separate webhook signing secret.
CASHFREE_WEBHOOK_SECRET=
# Pin API version used by Nest Cashfree client
CASHFREE_API_VERSION=2025-01-01

# Razorpay (legacy placeholder — not used; Cashfree is the Phase 1 provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=Cypher <noreply@localhost>

# Observability
SENTRY_DSN=
LOG_LEVEL=info
