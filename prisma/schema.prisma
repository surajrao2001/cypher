generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, postgis_topology, fuzzystrmatch, postgis_tiger_geocoder]
}

enum PlatformRole {
  user
  admin
}

enum ProfileStatus {
  active
  suspended
  deleted
}

enum OrganizerVerificationStatus {
  pending
  verified
  rejected
}

enum OrganizerMemberRole {
  owner
  manager
  editor
}

enum EventStatus {
  draft
  published
  registration_closed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  refunded
  failed
}

enum RegistrationStatus {
  pending_payment
  confirmed
  waitlist
  expired
  cancelled
  refunded
}

model Profile {
  id           String        @id @db.Uuid
  name         String
  dancerName   String?       @map("dancer_name")
  city         String?
  crew         String?
  styles       String[]      @default([])
  instagram    String?
  avatarUrl    String?       @map("avatar_url")
  platformRole PlatformRole  @default(user) @map("platform_role")
  status       ProfileStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  createdOrganizers Organizer[]           @relation("OrganizerCreator")
  organizerMembers  OrganizerMember[]
  registrations     Registration[]
  participants      RegistrationParticipant[]
  auditLogs         AuditLog[]

  @@map("profiles")
}

model Organizer {
  id                 String                       @id @default(uuid()) @db.Uuid
  orgName            String                       @map("org_name")
  slug               String                       @unique
  city               String?
  verificationStatus OrganizerVerificationStatus  @default(pending) @map("verification_status")
  bio                String?
  bannerUrl          String?                      @map("banner_url")
  logoUrl            String?                      @map("logo_url")
  instagram          String?
  createdById        String                       @map("created_by") @db.Uuid
  createdBy          Profile                      @relation("OrganizerCreator", fields: [createdById], references: [id])
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  members OrganizerMember[]
  events  Event[]

  @@map("organizers")
}

model OrganizerMember {
  organizerId String              @map("organizer_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        OrganizerMemberRole
  createdAt   DateTime            @default(now()) @map("created_at")

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizerId, userId])
  @@map("organizer_members")
}

model Event {
  id                    String      @id @default(uuid()) @db.Uuid
  organizerId           String      @map("organizer_id") @db.Uuid
  slug                  String      @unique
  title                 String
  description           String?
  eventType             String      @default("battle") @map("event_type")
  city                  String
  venue                 String?
  location              Unsupported("geography(Point, 4326)")?
  startTime             DateTime    @map("start_time")
  endTime               DateTime?   @map("end_time")
  registrationOpensAt   DateTime?   @map("registration_opens_at")
  registrationClosesAt  DateTime?   @map("registration_closes_at")
  posterUrl             String?     @map("poster_url")
  status                EventStatus @default(draft)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  organizer    Organizer         @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  categories   EventCategory[]
  registrations Registration[]
  videos       Video[]

  @@index([status, startTime], map: "events_status_start_idx")
  @@index([city, startTime], map: "events_city_start_idx")
  @@map("events")
}

model EventCategory {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  name           String
  priceMinor     Int    @default(0) @map("price_minor")
  capacity       Int
  reservedCount  Int    @default(0) @map("reserved_count")
  confirmedCount Int    @default(0) @map("confirmed_count")
  teamSize       Int    @default(1) @map("team_size")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  videos        Video[]

  @@map("event_categories")
}

model Registration {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  eventId               String             @map("event_id") @db.Uuid
  categoryId            String             @map("category_id") @db.Uuid
  paymentStatus         PaymentStatus      @default(pending) @map("payment_status")
  registrationStatus    RegistrationStatus @default(pending_payment) @map("registration_status")
  reservationExpiresAt  DateTime?          @map("reservation_expires_at")
  totalAmountMinor      Int                @map("total_amount_minor")
  registrationCode      String             @unique @map("registration_code")
  ticketQrToken         String?            @unique @map("ticket_qr_token")
  createdAt             DateTime           @default(now()) @map("created_at")
  confirmedAt           DateTime?          @map("confirmed_at")

  user         Profile                    @relation(fields: [userId], references: [id])
  event        Event                      @relation(fields: [eventId], references: [id])
  category     EventCategory              @relation(fields: [categoryId], references: [id])
  participants RegistrationParticipant[]
  paymentOrders PaymentOrder[]

  @@unique([userId, categoryId])
  @@map("registrations")
}

model RegistrationParticipant {
  id             String  @id @default(uuid()) @db.Uuid
  registrationId String  @map("registration_id") @db.Uuid
  userId         String? @map("user_id") @db.Uuid
  displayName    String  @map("display_name")
  dancerName     String? @map("dancer_name")
  email          String?
  isTeamCaptain  Boolean @default(false) @map("is_team_captain")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         Profile?     @relation(fields: [userId], references: [id])

  @@map("registration_participants")
}

model PaymentOrder {
  id              String   @id @default(uuid()) @db.Uuid
  registrationId  String   @map("registration_id") @db.Uuid
  provider        String   @default("razorpay")
  providerOrderId String   @unique @map("provider_order_id")
  amountMinor     Int      @map("amount_minor")
  currency        String   @default("INR")
  status          String   @default("created")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  registration Registration @relation(fields: [registrationId], references: [id])
  payments     Payment[]

  @@map("payment_orders")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  paymentOrderId    String   @map("payment_order_id") @db.Uuid
  providerPaymentId String   @unique @map("provider_payment_id")
  amountMinor       Int      @map("amount_minor")
  status            String
  method            String?
  createdAt         DateTime @default(now()) @map("created_at")

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@map("payments")
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid()) @db.Uuid
  idempotencyKey    String    @unique @map("idempotency_key")
  eventType         String    @map("event_type")
  payload           Json
  processingStatus  String    @default("received") @map("processing_status")
  receivedAt        DateTime  @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")
  error             String?

  @@map("payment_webhook_events")
}

model Video {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  round        String?
  title        String
  youtubeId    String   @map("youtube_id")
  thumbnailUrl String?  @map("thumbnail_url")
  createdAt    DateTime @default(now()) @map("created_at")

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category EventCategory? @relation(fields: [categoryId], references: [id])

  @@map("videos")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}
